version: 2

updates:
%{~ if pip_enabled }
  - package-ecosystem: pip
    directory: "${pip_directory}"
    schedule:
      interval: weekly
    groups:
      security-fixes:
        applies-to: security-updates
        patterns:
          - "*"
%{ endif }
  - package-ecosystem: github-actions
    directory: "/"
    schedule:
      interval: weekly
    groups:
      security-fixes:
        applies-to: security-updates
        patterns:
          - "*"
%{ if npm_directory != null }
  - package-ecosystem: npm
    directory: "${npm_directory}"
    schedule:
      interval: weekly
    groups:
      security-fixes:
        applies-to: security-updates
        patterns:
          - "*"
%{ endif ~}
%{ if terraform_directory != null }
  - package-ecosystem: terraform
    directory: "${terraform_directory}"
    schedule:
      interval: weekly
%{ endif ~}
