version: 2

updates:
  - package-ecosystem: pip
    directory: "${pip_directory}"
    schedule:
      interval: weekly
    groups:
      security-fixes:
        applies-to: security-updates
        patterns:
          - "*"

  - package-ecosystem: github-actions
    directory: "/"
    schedule:
      interval: weekly
    groups:
      security-fixes:
        applies-to: security-updates
        patterns:
          - "*"
%{ if npm_directory != null }
  - package-ecosystem: npm
    directory: "${npm_directory}"
    schedule:
      interval: weekly
    groups:
      security-fixes:
        applies-to: security-updates
        patterns:
          - "*"
%{ endif ~}
